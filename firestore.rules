rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════
    //  QUIÉN ES QUIÉN
    //  ─────────────────────────────────────────────────────────
    //  El registro público de Firebase está abierto (cualquiera puede crear
    //  una cuenta), así que NO alcanza con "estar logueado": solo estos UIDs
    //  pueden tocar la base.
    //
    //  Dos roles:
    //   · dueño    — todo.
    //   · empleado — trabaja (reparaciones, equipos, ventas, gastos,
    //                inventario) pero NO ve la plata del día ni borra nada.
    //
    //  ⚠️ Estas dos listas tienen que decir lo mismo que `TP_USUARIOS` en
    //     roles.js. tests/test-roles.js falla si se separan.
    //     Esconder cosas en la pantalla es comodidad; lo que de verdad frena
    //     es este archivo, y este archivo NO viaja con el git push:
    //     firebase deploy --only firestore:rules --project stockcelustech
    // ══════════════════════════════════════════════════════════
    function esDueno() {
      return request.auth != null && request.auth.uid in [
        'G9jAIYy86MZ1qTjRmMFyK9yO93e2'   // guyrepair22@gmail.com (Alan)
      ];
    }

    function esEmpleado() {
      return request.auth != null && request.auth.uid in [
        'PONER_ACA_EL_UID_DEL_EMPLEADO'  // placeholder: no es el UID de nadie
      ];
    }

    function isAllowed() { return esDueno() || esEmpleado(); }

    // ── config/owner: PIN de dueño (hasheado con PBKDF2) ──
    // Ni leerlo: el empleado no tiene que poder sacarle el hash ni borrarlo
    // para ponerse uno propio.
    match /config/owner {
      allow read: if esDueno();
      allow delete: if esDueno();
      allow create, update: if esDueno()
                   && (!('pin' in request.resource.data))
                   && (!('pinHash' in request.resource.data)
                       || request.resource.data.pinHash is string);
    }

    // ── Resto de config (templates WA, numeración de órdenes, marcas…) ──
    // El empleado escribe acá sin saberlo: `config/repairsMeta` es el
    // contador de números de orden, y sin eso no puede tomar una reparación.
    match /config/{doc} {
      allow read, write: if isAllowed();
    }

    // ── Subcolección de dispositivos para push ──
    match /caja_config/{doc=**} {
      allow read, write: if isAllowed();
    }

    // ── Backups: solo crear/leer, nunca borrar desde el cliente ──
    match /backups/{doc} {
      allow read, create: if esDueno();
      allow update, delete: if false;
    }

    // ── La plata del día ──
    // Apertura, cierre, cierres de turno y la caja del dueño: el empleado ni
    // los lee. Es lo que pidió el negocio: que trabaje sin ver cuánto entró.
    match /caja_arqueos/{doc}           { allow read, write: if esDueno(); }
    match /caja_cierres/{doc}           { allow read, write: if esDueno(); }
    match /caja_cierres_parciales/{doc} { allow read, write: if esDueno(); }
    match /caja_dueno_movimientos/{doc} { allow read, write: if esDueno(); }

    // ── Movimientos de caja ──
    // El empleado carga ventas y gastos, y puede corregir lo que cargó mal.
    // Borrar, no: un error se corrige, no se hace desaparecer.
    match /caja_movimientos/{doc} {
      allow read, create, update: if isAllowed();
      allow delete: if esDueno();
    }

    // ── Registro de accesos ──
    // Todos lo escriben al abrir la app (queda quién entró, ver tpFirma en
    // roles.js); leerlo es del dueño.
    match /accessLogs/{doc} {
      allow create: if isAllowed();
      allow read: if esDueno();
      allow update, delete: if false;
    }

    // ── Seguimiento público de reparaciones (QR del ticket) ──
    // Lectura PÚBLICA (el cliente escanea el QR sin estar logueado).
    // Contiene SOLO datos no sensibles: estado, equipo, fechas.
    // Escritura: solo cuentas autorizadas.
    match /seguimiento_publico/{token} {
      // GET: cualquiera puede leer UN documento si conoce su id, que es el
      // token aleatorio del QR. LIST queda prohibido: sin el token no se puede
      // recorrer la coleccion ni averiguar que ordenes existen.
      allow get: if true;
      allow list: if false;
      allow write: if isAllowed();
    }

    // ── Todas las demás colecciones del negocio ──
    // (stock, repairs, repuestos, productos, precios_reparaciones, placas,
    //  pedidos, clientes, actividad, etc.)
    // El empleado trabaja normalmente; borrar es del dueño.
    match /{document=**} {
      allow read, create, update: if isAllowed();
      allow delete: if esDueno();
    }
  }
}
